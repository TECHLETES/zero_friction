# Copy this file to .env for local development. Never commit real credentials.

# Zero Friction API key (APIM subscription key)
ZF_API_KEY=your_api_key_here

# OAuth 2.0 client credentials
ZF_CLIENT_ID=your_client_id_here
ZF_CLIENT_SECRET=your_client_secret_here

# Zero Friction identifiers
ZF_TENANT_ID=your_tenant_uuid_here
ZF_ORG_ID=your_organization_uuid_here

# Optional basic-auth credentials
ZF_USERNAME=your_username_here
ZF_PASSWORD=your_password_here
