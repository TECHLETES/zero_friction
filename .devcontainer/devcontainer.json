{
  "image": "ghcr.io/techletes/devcontainer:latest",
  "initializeCommand": "bash ${localWorkspaceFolder}/.devcontainer/initialize.sh",
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/tmp/host-gitconfig,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached"
  ],
  "name": "zero-friction",
  "overrideCommand": true,
  "postAttachCommand": "techletes-dev post-attach python",
  "postCreateCommand": "techletes-dev post-create python",
  "waitFor": "postCreateCommand",
  "workspaceFolder": "/workspaces/app",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/app,type=bind,consistency=cached"
}
