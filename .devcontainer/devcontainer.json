{
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "PRE_COMMIT_HOME": "/home/vscode/.cache/pre-commit",
    "PYTHONPATH": "/workspaces/${localWorkspaceFolderBasename}",
    "TZ": "Europe/Amsterdam",
    "UV_CACHE_DIR": "/home/vscode/.cache/uv",
    "UV_LINK_MODE": "copy",
    "UV_PROJECT_ENVIRONMENT": "/workspaces/${localWorkspaceFolderBasename}/.venv",
    "UV_PYTHON_DOWNLOADS": "never"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "astral-sh.ty",
        "ms-python.autopep8",
        "ms-python.black-formatter",
        "ms-python.debugpy",
        "mgesbert.python-path",
        "docker.docker",
        "dbaeumer.vscode-eslint",
        "tamasfe.even-better-toml",
        "cweijan.vscode-office",
        "openai.chatgpt",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "ms-azuretools.vscode-azure-github-copilot",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mysql",
        "mtxr.sqltools-driver-pg",
        "mtxr.sqltools-driver-sqlite",
        "ms-ossdata.vscode-pgsql",
        "formulahendry.docker-explorer",
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright",
        "me-dutour-mathieu.vscode-github-actions",
        "matthewpi.caddyfile-support",
        "charliermarsh.ruff"
      ],
      "settings": {
        "jupyter.jupyterServerType": "local",
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "python.testing.pytestArgs": [
          "."
        ],
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "ruff.enable": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.env.linux": {
          "PYTHONPATH": "${workspaceFolder}",
          "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv"
        }
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "enableNonRootDocker": "true",
      "moby": "false",
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=fst-uv-cache,target=/home/vscode/.cache/uv,type=volume",
    "source=fst-pre-commit-cache,target=/home/vscode/.cache/pre-commit,type=volume",
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached"
  ],
  "name": "python-template",
  "overrideCommand": true,
  "postAttachCommand": "bash .devcontainer/post-attach.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteEnv": {
    "CODEX_HOME": "/home/vscode/.codex"
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "waitFor": "postCreateCommand",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}"
}
